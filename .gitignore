.idea
_site
.jekyll-metadata
.DS_Store

# IDE project/workspace files
*.iml
*.code-workspace

# The app no longer runs locally, so this file should not exist any more.
# Kept ignored so a leftover copy can never be committed: it holds real
# GitHub OAuth credentials.
admin-app/.env
# `make app-build` compiles the admin app here as a fast compile check. The
# deployed binary is built inside admin-app/Dockerfile, never from this one.
admin-app/admin

# `make app-demo` writes what an editing session would have proposed here, and
# `make app-preview` dumps the rendered pages. Both are throwaway local output.
demo-out/
preview-out/
.agents
skills-lock.json
