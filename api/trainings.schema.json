{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://trainings.arc42.org/api/trainings.schema.json",
  "title": "arc42 training dates feed",
  "type": "object",
  "required": ["generated", "courses"],
  "properties": {
    "generated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" },
    "courses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "short_title", "title", "url", "trainers", "dates"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "short_title": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "blurb": { "type": "string" },
          "certification": { "type": ["string", "null"] },
          "credits": {
            "type": ["string", "null"],
            "description": "DEPRECATED, German prose, generated. Kept because four consumer sites render it verbatim. Read credit_points instead and render it in your own language."
          },
          "credit_points": {
            "type": "object",
            "description": "iSAQB credit points by category. Canonical; 'credits' is derived from this.",
            "additionalProperties": false,
            "properties": {
              "methodical":    { "type": "integer", "minimum": 0 },
              "technical":     { "type": "integer", "minimum": 0 },
              "communication": { "type": "integer", "minimum": 0 }
            },
            "minProperties": 1
          },
          "url": { "type": "string", "pattern": "^https://" },
          "url_en": { "type": "string", "pattern": "^https://" },
          "trainers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "dates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "code", "start", "end", "language", "format", "status", "url"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "code": { "type": "string", "minLength": 1 },
                "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "end": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "city": { "type": "string" },
                "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
                "language": { "enum": ["de", "en"] },
                "format": { "enum": ["public", "inhouse", "online"] },
                "trainers": { "type": "array", "items": { "type": "string" } },
                "pricing": {
                  "type": "string",
                  "description": "DEPRECATED, German prose, generated at build time from 'price' against the build date. An expired early-bird offer is simply absent from this string. Read 'price' instead and render it in your own language."
                },
                "price": {
                  "type": "object",
                  "description": "Canonical price. Amounts are integers in the minor-unit-free currency unit (2890 means 2890 EUR).",
                  "additionalProperties": false,
                  "required": ["amount", "currency"],
                  "properties": {
                    "amount":   { "type": "integer", "minimum": 0 },
                    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
                    "alumni": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Reduced price for former participants. Unlike early_bird this never expires, so it is always published when present."
                    },
                    "early_bird": {
                      "type": "object",
                      "description": "Only published while still valid. Consumers do NOT need to check the date: the producer omits an expired offer.",
                      "additionalProperties": false,
                      "required": ["amount", "until"],
                      "properties": {
                        "amount": { "type": "integer", "minimum": 0 },
                        "until":  { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
                      }
                    }
                  }
                },
                "few_seats": {
                  "type": "string",
                  "description": "DEPRECATED, generated. Present only when seats_limited is true. Read seats_limited instead."
                },
                "seats_limited": {
                  "type": "boolean",
                  "description": "Canonical. True when only a few seats remain; the wording is the consumer's to choose."
                },
                "url": { "type": "string", "pattern": "^https://" },
                "status": { "enum": ["open", "waitlist", "full", "cancelled"] }
              },
              "allOf": [
                {
                  "if": { "properties": { "format": { "enum": ["public", "inhouse"] } } },
                  "then": { "required": ["city"], "properties": { "city": { "type": "string", "minLength": 1 } } }
                }
              ]
            }
          }
        }
      }
    }
  }
}
