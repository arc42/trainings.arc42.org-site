{{define "propose.gohtml"}}{{template "layout" .}}{{end}}
{{define "content"}}
<h1>Review &amp; propose</h1>
{{/* Two piles, because they ask different things of the operator. Their own
     entries they can fix, and the link takes them to the field. What the app
     got wrong they cannot fix, and must not be told to: they get the reason,
     a way to report it, and the pull request anyway, since CI checks it again.
     "CI would reject them" is said only of the first pile, where it is true. */}}
{{with .EntryProblems}}
<div class="problems" role="alert">
  <h2>Fix these in your entries</h2>
  <ul>{{range .}}<li>{{with .Where}}{{.}} — {{end}}{{.Label}}: {{.Message}}{{with .Link}} <a href="{{.}}">Edit</a>{{end}}</li>{{end}}</ul>
  <p>Fix these before opening a pull request — CI would reject them too.</p>
</div>
{{end}}
{{with .AppFaults}}
{{/* Calmer than the red box on purpose: nothing here is the operator's to
     fix, and an alarm would say otherwise. status, not alert. */}}
<div class="app-fault" role="status">
  <p>This is not caused by your entries, and your draft is saved.
    The admin app could not check it before opening the pull request.
    Please send Gernot a screenshot of this page.</p>
  <p>You can still open the pull request: CI checks it again.</p>
  <details><summary>Technical detail</summary>
    <ul>{{range .}}<li><code>{{.Detail}}</code></li>{{end}}</ul>
  </details>
</div>
{{end}}
{{template "notes" .Notes}}

{{/* One card per change, listing only the fields that actually moved. The
     unified diff below is still here, and still what CI sees, but it is not
     what a person deciding whether to publish should have to read: marking a
     run as "few seats left" showed up there as four lines of YAML context
     around one key. */}}
<h2>What changed</h2>
{{range .Draft.Changes}}
{{$kind := .Kind}}
<section class="report">
  <h3 class="report-head">
    <span class="kind kind-{{$kind}}">{{$kind}}</span>
    <span class="report-what">{{.Headline}}</span>
  </h3>
  {{with .Fields}}
  <table class="report-fields">
    <thead>
      <tr>
        <th scope="col">Field</th>
        {{if ne $kind "added"}}<th scope="col">Before</th>{{end}}
        {{if ne $kind "removed"}}<th scope="col">After</th>{{end}}
      </tr>
    </thead>
    <tbody>
      {{range .}}
      <tr>
        <th scope="row">{{.Label}}</th>
        {{if ne $kind "added"}}<td class="was">{{.Before}}</td>{{end}}
        {{if ne $kind "removed"}}<td class="now">{{.After}}</td>{{end}}
      </tr>
      {{end}}
    </tbody>
  </table>
  {{else}}
  <p class="hint">No net change — this was edited back to what the file already says.</p>
  {{end}}
</section>
{{end}}

{{with .Diff}}
<details class="rawdiff">
  <summary>YAML diff against <code>main</code> — what CI will see</summary>
  <pre class="diff">{{.}}</pre>
</details>
{{end}}

{{if not .EntryProblems}}
<form method="post" action="/propose" class="detail" data-submit-once>
<label>Pull request title<input name="title" value="{{.PRTitle}}" required></label>
<label>Description<textarea name="body" rows="12">{{.PRBody}}</textarea></label>
<div class="actions"><button type="submit" data-idle="Open pull request" data-busy="Opening pull request…">Open pull request</button> <a href="/">Keep editing</a></div>
</form>
<script src="/static/form.js" defer></script>{{end}}
{{end}}
