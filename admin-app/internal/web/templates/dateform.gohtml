{{define "dateform.gohtml"}}{{template "layout" .}}{{end}}
{{define "content"}}
<h1>{{.Title}}</h1>
<p class="lede">Fields marked <span class="req" aria-hidden="true">*</span> are
  required. Nothing is published from here: saving adds the change to your draft,
  and you review the whole diff before it becomes a pull request.</p>

{{template "problems" .Problems}}
{{template "warnings" .Warnings}}

<form method="post" action="/dates/{{if .IsNew}}new{{else}}{{.Date.ID}}{{end}}" class="detail">

  <fieldset class="group">
    <legend>Which course</legend>
    <label>Course <span class="req" aria-hidden="true">*</span>
      <select name="course_id" required>
        {{$cid := .CourseID}}
        {{range .Courses}}{{$d := defaultsOf .}}<option value="{{.ID}}"
          data-code-token="{{codeToken .ID}}"
          data-city="{{$d.City}}" data-country="{{$d.Country}}"
          data-price-amount="{{with $d.Price}}{{.Amount}}{{end}}"
          data-price-currency="{{with $d.Price}}{{.Currency}}{{end}}"
          data-trainers="{{join $d.Trainers ", "}}"
          {{if eqStr .ID $cid}}selected{{end}}>{{.ShortTitle}} — {{.Title}}</option>{{end}}
      </select>
      <small id="course-hint" class="hint">Which course this run belongs to.
        Changing it moves the date to another course and re-derives the booking
        code.</small>
    </label>
    <label>Date ID <span class="req" aria-hidden="true">*</span>
      <input name="id" value="{{.Date.ID}}" required pattern="[a-z0-9-]+"
             aria-describedby="id-hint" placeholder="{{idMask .CourseID}}">
      <small id="id-hint" class="hint">Lower-case letters, digits and hyphens. Used
        in the anchor link on arc42.de, so it never changes once published.</small>
    </label>
    <label>Booking code <span class="req" aria-hidden="true">*</span>
      <input name="code" id="f-code" value="{{.Date.Code}}" required
             aria-describedby="code-hint" placeholder="{{codeMask .CourseID}}">
      <small id="code-hint" class="hint">Filled in for you from the course, the
        start date and the language. Overwrite it if this run needs a different
        code. Must be unique — a duplicate silently misroutes a registration.</small>
    </label>
  </fieldset>

  <fieldset class="group">
    <legend>When</legend>
    <div class="row">
      <label>First day <span class="req" aria-hidden="true">*</span>
        <input type="date" name="start" id="f-start" value="{{.Date.Start}}" required
               aria-describedby="start-hint">
        <small id="start-hint" class="hint">The first teaching day. Setting it
          fills in the last day, the booking code and the date id.</small>
      </label>
      <label>Last day <span class="req" aria-hidden="true">*</span>
        <input type="date" name="end" id="f-end" value="{{.Date.End}}" required
               aria-describedby="end-hint">
        <small id="end-hint" class="hint">Defaults to the day after the first
          day; change it for a longer course.</small>
      </label>
    </div>
  </fieldset>

  <fieldset class="group">
    <legend>Where</legend>
    <label>Format <span class="req" aria-hidden="true">*</span>
      <select name="format" required>
        {{$f := .Date.Format}}
        {{range .Formats}}<option value="{{.}}" {{if eqStr . $f}}selected{{end}}>{{.}}</option>{{end}}
      </select>
      <small id="format-hint" class="hint"><b>public</b> is the open enrolment
        course, <b>inhouse</b> is booked by one client, <b>online</b> is remote.
        public and inhouse need a city; online does not.</small>
    </label>
    <div class="row">
      <label>City
        <input name="city" value="{{.Date.City}}" aria-describedby="city-hint"
               placeholder="e.g. München">
        <small id="city-hint" class="hint">Required for public and inhouse; leave
          empty for online.</small>
      </label>
      <label>Country
        <input name="country" value="{{.Date.Country}}" maxlength="2"
               pattern="[A-Za-z]{2}" placeholder="e.g. DE" aria-describedby="country-hint">
        <small id="country-hint" class="hint">Two-letter code, optional.</small>
      </label>
    </div>
  </fieldset>

  <fieldset class="group">
    <legend>How it is offered</legend>
    <div class="row">
      <label>Language taught in <span class="req" aria-hidden="true">*</span>
        <select name="language" id="f-language" required>
          {{$l := .Date.Language}}
          {{range .Languages}}<option value="{{.}}" {{if eqStr . $l}}selected{{end}}>{{.}}</option>{{end}}
        </select>
        <small id="language-hint" class="hint">The language the course is taught
          in — not the language of the page it appears on. An English course
          gets "-EN" in its booking code.</small>
      </label>
      <label>Booking status <span class="req" aria-hidden="true">*</span>
        <select name="status" required>
          {{$s := .Date.Status}}
          {{range .Statuses}}<option value="{{.}}" {{if eqStr . $s}}selected{{end}}>{{.}}</option>{{end}}
        </select>
        <small id="status-hint" class="hint">Only <b>open</b> appears in the
          registration form on arc42.de. <b>waitlist</b> and <b>full</b> still
          show on the timeline, marked sold out; <b>cancelled</b> disappears
          everywhere. Anything but open means nobody can book this date.</small>
      </label>
    </div>
    {{/* No registration URL field: every published date links to the same
         anchored page, so the date id already determines it. The server writes
         https://www.arc42.de/termine#<id> on save. */}}
  </fieldset>

  {{template "trainers" dict "Selected" .Date.Trainers "Known" .KnownTrainers "Other" .OtherTrainers}}

  <fieldset class="group">
    <legend>Price</legend>
    {{/* Numbers, not a sentence. This used to be one free-text "Pricing" box
         holding a German sentence with the early-bird deadline written inside
         it, which meant the deadline was invisible to every machine and the
         site advertised an expired price for weeks. Amounts are whole euros;
         the wording, the € symbol and the thousands separator are added per
         language at render time, so nothing typed here can be wrong in
         English. */}}
    <div class="row">
      <label>Regular price
        <input name="price_amount" type="number" min="0" step="1" inputmode="numeric"
               value="{{with .Date.Price}}{{.Amount}}{{end}}"
               placeholder="e.g. 2890" aria-describedby="price-hint">
        <small id="price-hint" class="hint">Digits only, whole currency units.
          Leave empty when this run has no published price.</small>
      </label>
      <label>Alumni price
        <input name="price_alumni" type="number" min="0" step="1" inputmode="numeric"
               value="{{with .Date.Price}}{{if .Alumni}}{{.Alumni}}{{end}}{{end}}"
               placeholder="e.g. 2050" aria-describedby="alumni-hint">
        <small id="alumni-hint" class="hint">The reduced price for former
          participants. Unlike the early-bird price it never expires. Leave
          empty when the course has no alumni rate.</small>
      </label>
    </div>
    <div class="row">
      <label>Currency
        <input name="price_currency" pattern="[A-Za-z]{3}" maxlength="3"
               value="{{with .Date.Price}}{{.Currency}}{{else}}EUR{{end}}"
               aria-describedby="currency-hint">
        <small id="currency-hint" class="hint">ISO code. EUR unless something
          has genuinely changed.</small>
      </label>
    </div>
    <div class="row">
    <div class="row">
      <label>Early-bird price
        <input name="early_bird_amount" type="number" min="0" step="1" inputmode="numeric"
               value="{{with .Date.Price}}{{with .EarlyBird}}{{.Amount}}{{end}}{{end}}"
               placeholder="e.g. 2690" aria-describedby="eb-hint">
        <small id="eb-hint" class="hint">Leave empty for no early-bird offer.
          Must be below the regular price.</small>
      </label>
      <label>Early-bird deadline
        <input name="early_bird_until" type="date"
               value="{{with .Date.Price}}{{with .EarlyBird}}{{.Until}}{{end}}{{end}}"
               aria-describedby="ebu-hint">
        <small id="ebu-hint" class="hint">The last day the offer applies. After
          it passes the site and the feed drop the offer on their own, so an
          expired one does not need deleting.</small>
      </label>
    </div>
  </fieldset>

  <fieldset class="group">
    <legend>Optional notes</legend>
    <label class="check">
      <input type="checkbox" name="seats_limited" value="1" {{if .Date.SeatsLimited}}checked{{end}}>
      <span>Only a few seats left</span>
    </label>
    <small class="hint">Adds a short nudge to the card. The wording is written
      per language by the site, so there is nothing to type. Leave it off
      unless seats really are running out.</small>
  </fieldset>

  {{template "actions" dict "Warnings" .Warnings "IsNew" .IsNew "Cancel" "/"}}
</form>
<script src="/static/form.js" defer></script>
{{end}}
