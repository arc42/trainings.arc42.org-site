{{define "login.gohtml"}}{{template "layout" .}}{{end}}
{{define "content"}}
<div class="hero">
  <img class="hero-mascot" src="/static/mascot.png" alt="" width="242" height="256">
  {{if .NoticeTitle}}
  <h1>{{.NoticeTitle}}</h1>
  <p class="lede">{{.Notice}}</p>
  {{else}}
  <h1>arc42 trainings admin</h1>
  <p class="lede">Add, change and cancel arc42 training dates. Every editing
    session becomes one pull request against <code>_data/trainings.yml</code> —
    reviewed and merged on GitHub, so nothing publishes by accident.</p>
  {{end}}
  <p><a class="button" href="/auth/github">Sign in with GitHub</a></p>
  <p class="hint">Requires push access to the trainings repository.</p>
  {{/* Ways out. This page is where signing out lands, and where every outsider
       ends up, so it must not be a dead end. The pull-request link opens in a
       new tab: a maintainer merging the PR they just opened keeps this tab. */}}
  <p class="ways-out">
    <a class="button secondary" href="https://trainings.arc42.org">Back to trainings.arc42.org</a>
    <a class="button secondary" href="https://github.com/{{.Repo}}/pulls" target="_blank" rel="noopener">Pull requests on GitHub ↗</a>
  </p>
  <footer class="hero-footer">
    <hr>
    crafted with passion in Cologne
    <span aria-hidden="true">·</span> <a href="https://status.arc42.org">Status</a>
    <span aria-hidden="true">·</span> <a href="https://github.com/{{.Repo}}">{{.Repo}}</a>
  </footer>
</div>
{{end}}
