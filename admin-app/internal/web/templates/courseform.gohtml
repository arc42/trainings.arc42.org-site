{{define "courseform.gohtml"}}{{template "layout" .}}{{end}}
{{define "content"}}
<h1>{{.Title}}</h1>
<p class="lede">A course is the thing people book a date of — MSA, FLEX and so on.
  Fields marked <span class="req" aria-hidden="true">*</span> are required.
  {{if .IsNew}}A new course starts with no dates; add them from the
  <a href="/">dates list</a> once it is saved.{{end}}</p>

{{template "problems" .Problems}}
{{template "warnings" .Warnings}}
{{template "notes" .Notes}}

<form method="post" action="/courses/{{if .IsNew}}new{{else}}{{.StoredID}}{{end}}" class="detail">

  <fieldset class="group">
    <legend>Identity</legend>
    <label>Course ID <span class="req" aria-hidden="true">*</span>
      {{/* The pattern accepts what the server turns into an id (capitals,
           spaces, underscores: normaliseID), so it never refuses what saving
           would fix. The hyphen is escaped: browsers compile pattern= with
           the RegExp v flag, where [a-z0-9-] is a syntax error, and an
           invalid pattern is silently not checked at all.
           TestIDPatternsValidInVMode keeps it that way. */}}
      <input name="id" id="c-id" value="{{.Course.ID}}" required pattern="[A-Za-z0-9_ \-]+"
             title="lower-case letters, digits and hyphens; spaces and underscores become hyphens"
             autocapitalize="none" spellcheck="false" autocomplete="off" data-lowercase
             aria-describedby="cid-hint" placeholder="e.g. msa" {{if not .IDEditable}}readonly{{end}}>
      <small id="cid-hint" class="hint">Lower-case letters, digits and hyphens;
        capitals, spaces and underscores are converted when you save.
        {{if .IsNew}}Every date links to its course by this value.
        {{else if .IDEditable}}Still editable: this course is only in your draft
        and has no dates yet.
        {{else if .DraftOnly}}Not editable while the course has dates, which
        reference it — remove its dates to change it.
        {{else}}Not editable — the dates below reference it.{{end}}</small>
    </label>
    <label>Short title <span class="req" aria-hidden="true">*</span>
      <input name="short_title" value="{{.Course.ShortTitle}}" required
             aria-describedby="st-hint" placeholder="e.g. MSA">
      <small id="st-hint" class="hint">Used where space is tight: the dates table
        and the home page cards.</small>
    </label>
    <label>Full title <span class="req" aria-hidden="true">*</span>
      <input name="title" value="{{.Course.Title}}" required
             aria-describedby="ctitle-hint"
             placeholder="e.g. Mastering Software Architectures">
      <small id="ctitle-hint" class="hint">The complete name, used where there is
        room to spell it out.</small>
    </label>
    <label>Course URL <span class="req" aria-hidden="true">*</span>
      <input type="url" name="url" id="c-url" value="{{.Course.URL}}" required
             aria-describedby="curl-hint"
             placeholder="e.g. https://www.arc42.de/info-msa/">
      <small id="curl-hint" class="hint">The course description page people read
        before booking. Filled in from the id as
        https://www.arc42.de/info-&lt;id&gt;/ — change it if this course lives
        elsewhere. Must be https.</small>
    </label>
    <label>English course page (optional)
      <input type="url" name="url_en" value="{{.Course.URLEn}}"
             placeholder="e.g. https://trainings.arc42.org/courses/msa/" aria-describedby="url-en-hint">
      <small id="url-en-hint" class="hint">Shown instead of the course URL on the English
        arc42 sites. Leave empty if there is no English page.</small>
    </label>
  </fieldset>

  {{template "trainers" dict "Selected" .Course.Trainers "Known" .KnownTrainers "Other" .OtherTrainers}}

  {{/* Same pattern as the trainer roster: known sites as checkboxes, the
       rest typed in. Unticked means every site, which is why there is no
       "all sites" box: the YAML leaves show_on out, and an empty list would
       mean a course shown nowhere. */}}
  {{$shown := .Course.ShowOn}}
  <fieldset class="group" aria-describedby="show-on-hint">
    <legend>Shown on</legend>
    {{/* No id on the first line on purpose: form.js folds every .hint[id]
         behind a "?", and what an empty group means has to stay in view, or
         unticking everything reads as "hide this course". */}}
    <p class="hint">No box ticked: every site shows this course. trainings.arc42.org always shows every course.</p>
    <p class="hint" id="show-on-hint">Tick the sites that should advertise this
      course. A site not in the list goes in the last field.</p>
    <ul class="checks">
      {{range .KnownSites}}
      <li><label class="check">
        <input type="checkbox" name="show_on" value="{{.}}" {{if has $shown .}}checked{{end}}>
        <span>{{.}}</span>
      </label></li>
      {{end}}
    </ul>
    <label>Other sites <small>comma-separated</small>
      <input name="show_on_other" value="{{join .OtherSites ", "}}"
             placeholder="e.g. www.example.org">
    </label>
  </fieldset>

  {{/* One field per language, because the data-driven card shows the text in
       the page's language and cannot tell which language a single text is in.
       Either may stay empty: the card then shows the other one. */}}
  <fieldset class="group">
    <legend>Description</legend>
    <label>Description (German)
      <textarea name="blurb_de" rows="4" aria-describedby="blurb-de-hint"
                placeholder="e.g. Zwei erfahrene Trainer, durchgehend praxisnah und pragmatisch.">{{.Course.BlurbDE}}</textarea>
      <small id="blurb-de-hint" class="hint">Two or three sentences in German.
        Appears on the home page cards under the course name.</small>
    </label>
    <label>Description (English)
      <textarea name="blurb_en" rows="4" aria-describedby="blurb-en-hint"
                placeholder="e.g. Two expert trainers at all times, highly practical and pragmatic.">{{.Course.BlurbEN}}</textarea>
      <small id="blurb-en-hint" class="hint">The same in English. If only one of
        the two is filled in, both home pages show that one.</small>
    </label>
    <div class="row">
      <label>Certification
        <input name="certification" value="{{.Course.Certification}}"
               aria-describedby="cert-hint"
               placeholder="e.g. iSAQB CPSA-Foundation">
        <small id="cert-hint" class="hint">The certificate this course prepares
          for, if any. Leave empty when it prepares for none.</small>
      </label>
      {{/* Three counts, not the sentence this used to be. "20 methodische und
           10 technische Punkte" was German prose on a field rendered on the
           English pages too; the wording is now built per language from these
           numbers. */}}
      <label>iSAQB points, methodical
        <input name="credits_methodical" type="number" min="0" step="1" inputmode="numeric"
               value="{{with .Course.CreditPoints}}{{if .Methodical}}{{.Methodical}}{{end}}{{end}}"
               aria-describedby="credits-hint">
        <small id="credits-hint" class="hint">Leave all three empty if the
          course carries no credit points.</small>
      </label>
      <label>iSAQB points, technical
        <input name="credits_technical" type="number" min="0" step="1" inputmode="numeric"
               value="{{with .Course.CreditPoints}}{{if .Technical}}{{.Technical}}{{end}}{{end}}">
      </label>
      <label>iSAQB points, communication
        <input name="credits_communication" type="number" min="0" step="1" inputmode="numeric"
               value="{{with .Course.CreditPoints}}{{if .Communication}}{{.Communication}}{{end}}{{end}}">
      </label>
    </div>
  </fieldset>

  {{template "actions" dict "Warnings" .Warnings "IsNew" .IsNew "Cancel" "/courses"}}
</form>
{{/* Only for a course this draft added: nothing published refers to it yet.
     A link to a confirmation, like a date's Remove, never a direct POST. */}}
{{if .DraftOnly}}
<p class="remove-course"><a href="/courses/{{.StoredID}}/delete">Remove this course from the draft</a></p>
{{end}}
<script src="/static/form.js" defer></script>
{{end}}
