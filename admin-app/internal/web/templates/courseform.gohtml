{{define "courseform.gohtml"}}{{template "layout" .}}{{end}}
{{define "content"}}
<h1>{{.Title}}</h1>
<p class="lede">A course is the thing people book a date of — MSA, FLEX and so on.
  Fields marked <span class="req" aria-hidden="true">*</span> are required.
  {{if .IsNew}}A new course starts with no dates; add them from the
  <a href="/">dates list</a> once it is saved.{{end}}</p>

{{template "problems" .Problems}}
{{template "warnings" .Warnings}}

<form method="post" action="/courses/{{if .IsNew}}new{{else}}{{.Course.ID}}{{end}}" class="detail">

  <fieldset class="group">
    <legend>Identity</legend>
    <label>Course ID <span class="req" aria-hidden="true">*</span>
      <input name="id" id="c-id" value="{{.Course.ID}}" required pattern="[a-z0-9-]+"
             aria-describedby="cid-hint" placeholder="e.g. msa" {{if not .IsNew}}readonly{{end}}>
      <small id="cid-hint" class="hint">Lower-case letters, digits and hyphens.
        {{if .IsNew}}Every date links to its course by this value.
        {{else}}Not editable — the dates below reference it.{{end}}</small>
    </label>
    <label>Short title <span class="req" aria-hidden="true">*</span>
      <input name="short_title" value="{{.Course.ShortTitle}}" required
             aria-describedby="st-hint" placeholder="e.g. Mastering SW Architectures">
      <small id="st-hint" class="hint">Used where space is tight: the dates table
        and the timeline cards.</small>
    </label>
    <label>Full title <span class="req" aria-hidden="true">*</span>
      <input name="title" value="{{.Course.Title}}" required
             aria-describedby="ctitle-hint"
             placeholder="e.g. Mastering Software Architectures">
      <small id="ctitle-hint" class="hint">The complete name, used where there is
        room to spell it out.</small>
    </label>
    <label>Course URL <span class="req" aria-hidden="true">*</span>
      <input type="url" name="url" id="c-url" value="{{.Course.URL}}" required
             aria-describedby="curl-hint"
             placeholder="e.g. https://www.arc42.de/info-msa/">
      <small id="curl-hint" class="hint">The course description page people read
        before booking. Filled in from the id as
        https://www.arc42.de/info-&lt;id&gt;/ — change it if this course lives
        elsewhere. Must be https.</small>
    </label>
    <label>English course page (optional)
      <input type="url" name="url_en" value="{{.Course.URLEn}}"
             placeholder="e.g. https://trainings.arc42.org/courses/msa/" aria-describedby="url-en-hint">
      <small id="url-en-hint" class="hint">Shown instead of the course URL on the English
        arc42 sites. Leave empty if there is no English page.</small>
    </label>
  </fieldset>

  {{template "trainers" dict "Selected" .Course.Trainers "Known" .KnownTrainers "Other" .OtherTrainers}}

  <fieldset class="group">
    <legend>Description</legend>
    <label>Blurb
      <textarea name="blurb" rows="4" aria-describedby="blurb-hint"
                placeholder="e.g. Two expert trainers at all times, highly practical and pragmatic.">{{.Course.Blurb}}</textarea>
      <small id="blurb-hint" class="hint">Two or three sentences. Appears on the
        timeline card under the course name.</small>
    </label>
    <div class="row">
      <label>Certification
        <input name="certification" value="{{.Course.Certification}}"
               aria-describedby="cert-hint"
               placeholder="e.g. iSAQB CPSA-Foundation">
        <small id="cert-hint" class="hint">The certificate this course prepares
          for, if any. Leave empty when it prepares for none.</small>
      </label>
      {{/* Three counts, not the sentence this used to be. "20 methodische und
           10 technische Punkte" was German prose on a field rendered on the
           English pages too; the wording is now built per language from these
           numbers. */}}
      <label>iSAQB points, methodical
        <input name="credits_methodical" type="number" min="0" step="1" inputmode="numeric"
               value="{{with .Course.CreditPoints}}{{if .Methodical}}{{.Methodical}}{{end}}{{end}}"
               aria-describedby="credits-hint">
        <small id="credits-hint" class="hint">Leave all three empty if the
          course carries no credit points.</small>
      </label>
      <label>iSAQB points, technical
        <input name="credits_technical" type="number" min="0" step="1" inputmode="numeric"
               value="{{with .Course.CreditPoints}}{{if .Technical}}{{.Technical}}{{end}}{{end}}">
      </label>
      <label>iSAQB points, communication
        <input name="credits_communication" type="number" min="0" step="1" inputmode="numeric"
               value="{{with .Course.CreditPoints}}{{if .Communication}}{{.Communication}}{{end}}{{end}}">
      </label>
    </div>
  </fieldset>

  {{template "actions" dict "Warnings" .Warnings "IsNew" .IsNew "Cancel" "/courses"}}
</form>
<script src="/static/form.js" defer></script>
{{end}}
