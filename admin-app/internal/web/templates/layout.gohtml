{{define "layout"}}<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}} — arc42 trainings admin</title>
<link rel="stylesheet" href="/static/app.css">
<script src="/static/htmx.min.js" defer></script>
</head><body>
<header class="masthead"><a href="/">arc42 trainings admin</a>
<nav><a href="/">Dates</a> <a href="/courses">Courses</a>
{{if .Login}}<span class="who">{{.Login}}</span>
<form method="post" action="/auth/logout"><button class="link">Sign out</button></form>{{end}}</nav>
</header>
<main>{{template "content" .}}</main>
{{if .Draft}}{{template "draftbar.gohtml" .}}{{end}}
</body></html>{{end}}
