{{define "layout"}}<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}} — arc42 trainings admin</title>
<link rel="stylesheet" href="/static/app.css">
<link rel="icon" href="/static/mascot-small.png" type="image/png">
<script src="/static/htmx.min.js" defer></script>
</head><body>
{{/* Navigation appears only for a signed-in maintainer. Before sign-in every
     item bounces straight back here, and on the denied page (Bare) they are all
     dead ends — in both cases the nav would advertise structure to someone who
     has not established they may see any of it. */}}
{{$nav := and .Login (not .Bare)}}
<header class="masthead">{{if $nav}}<a class="brand" href="/"><img class="mascot" src="/static/mascot-small.png" alt="" width="48" height="51">arc42 trainings admin</a>{{else}}<span class="brand wordmark"><img class="mascot" src="/static/mascot-small.png" alt="" width="48" height="51">arc42 trainings admin</span>{{end}}
{{if $nav}}<nav><a href="/">Dates</a> <a href="/courses">Courses</a>
<span class="who">{{.Login}}</span>
<form method="post" action="/auth/logout"><button class="link">Sign out</button></form></nav>{{end}}
</header>
{{/* Wide opts one page out of the 75ch reading measure. It is a per-page
     decision, not a default: the measure is right for the prose pages and the
     forms, and wrong for a table of dates, which wrapped every row onto four
     lines inside it. A page that never sets the key gets the zero value from
     the data map and stays at 75ch. */}}
<main{{if .Wide}} class="wide"{{end}}>{{template "content" .}}</main>
{{/* On every page: the build line is what a maintainer checks after a deploy,
     and they are signed in when they do. .Build and .Repo are added by
     Server.render, so no handler has to remember them. */}}
<footer class="site-footer">
  {{/* The logo is the site's white SVG recoloured to --deep: white disappears
       on the light footer band. */}}
  <a class="site-footer-logo" href="https://arc42.org"><img src="/static/arc42-logo.svg" alt="arc42" width="96" height="27"></a>
  <div>
    <p class="site-footer-links">
      <a href="https://trainings.arc42.org">trainings.arc42.org</a>
      <span aria-hidden="true">·</span> <a href="https://status.arc42.org">Status</a>
      <span aria-hidden="true">·</span> <a href="https://github.com/{{.Repo}}">GitHub</a>
    </p>
    <p>Crafted with passion in Cologne by Gernot Starke.</p>
    <p class="site-footer-build">{{with .Build}}{{if .Commit}}Build <a href="https://github.com/{{$.Repo}}/commit/{{.Commit}}"><code>{{.Short}}</code></a>{{if .Dirty}} plus uncommitted changes{{end}}{{if .Time}}, deployed {{.Time}}{{end}}{{else}}Development build{{end}}{{end}}</p>
  </div>
</footer>
{{if .Draft}}{{template "draftbar.gohtml" .}}{{end}}
</body></html>{{end}}
